<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Histórico de Movimentações do Estoque</h2>
    <p class="text-muted mb-0">Rastreabilidade completa de todas as entradas, saídas manuais e baixas automáticas de vendas.</p>
  </div>
  <a href="/estoque" class="btn btn-outline-secondary rounded-pill px-4">
    <i class="fa-solid fa-arrow-left me-2"></i> Voltar ao Estoque
  </a>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Data / Hora</th>
            <th>Ingrediente</th>
            <th>Categoria</th>
            <th>Tipo</th>
            <th>Quantidade</th>
            <th>Motivo / Referência</th>
          </tr>
        </thead>
        <tbody>
          <% if (movimentacoes && movimentacoes.length > 0) { %>
            <% movimentacoes.forEach(mov => { %>
              <tr>
                <td><%= new Date(mov.data_movimentacao).toLocaleString('pt-BR') %></td>
                <td class="fw-bold"><%= mov.ingrediente_nome %></td>
                <td><span class="badge bg-secondary"><%= mov.categoria %></span></td>
                <td>
                  <% if (mov.tipo === 'ENTRADA') { %>
                    <span class="badge bg-success"><i class="fa-solid fa-arrow-down me-1"></i> Entrada</span>
                  <% } else if (mov.tipo === 'VENDA') { %>
                    <span class="badge bg-primary"><i class="fa-solid fa-cart-shopping me-1"></i> Venda</span>
                  <% } else if (mov.tipo === 'SAIDA_MANUAL' || mov.tipo === 'PERDA') { %>
                    <span class="badge bg-danger"><i class="fa-solid fa-arrow-up me-1"></i> Saída Manual</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark"><%= mov.tipo %></span>
                  <% } %>
                </td>
                <td class="fw-bold">
                  <%= mov.tipo === 'ENTRADA' ? '+' : '-' %><%= mov.quantidade %> <%= mov.unidade_medida %>
                </td>
                <td class="text-muted">
                  <%= mov.motivo || '-' %>
                  <% if (mov.pedido_id) { %>
                    <a href="/vendas/<%= mov.pedido_id %>" class="ms-1 text-info">(Pedido #<%= mov.pedido_id %>)</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">Nenhuma movimentação registrada até o momento.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
