<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><%= ingrediente ? 'Editar Ingrediente' : 'Novo Ingrediente / Insumo' %></h2>
    <p class="text-muted mb-0">Cadastre os insumos do cardápio para o cálculo de custos e controle automático de saldo.</p>
  </div>
  <a href="/estoque" class="btn btn-outline-secondary rounded-pill px-4">
    <i class="fa-solid fa-arrow-left me-2"></i> Voltar
  </a>
</div>

<div class="card">
  <div class="card-body">
    <form action="<%= ingrediente ? '/estoque/' + ingrediente.id + '/editar' : '/estoque/novo' %>" method="POST" class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Nome do Ingrediente <span class="text-danger">*</span></label>
        <input type="text" class="form-control" name="nome" value="<%= ingrediente?.nome || '' %>" required placeholder="Ex: Queijo Mussarela, Calabresa, Coca-Cola 2L">
      </div>

      <div class="col-md-3">
        <label class="form-label">Categoria <span class="text-danger">*</span></label>
        <select class="form-select" name="categoria" required>
          <% categorias.forEach(cat => { %>
            <option value="<%= cat %>" <%= ingrediente?.categoria === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Unidade de Medida <span class="text-danger">*</span></label>
        <select class="form-select" name="unidade_medida" required>
          <option value="g" <%= ingrediente?.unidade_medida === 'g' ? 'selected' : '' %>>Gramos (g)</option>
          <option value="kg" <%= ingrediente?.unidade_medida === 'kg' ? 'selected' : '' %>>Quilogramas (kg)</option>
          <option value="ml" <%= ingrediente?.unidade_medida === 'ml' ? 'selected' : '' %>>Militros (ml)</option>
          <option value="un" <%= ingrediente?.unidade_medida === 'un' ? 'selected' : '' %>>Unidades (un)</option>
          <option value="fatia" <%= ingrediente?.unidade_medida === 'fatia' ? 'selected' : '' %>>Fatias</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Quantidade em Estoque</label>
        <input type="number" step="0.01" class="form-control" name="quantidade_estoque" value="<%= ingrediente?.quantidade_estoque || 0 %>" <%= ingrediente ? 'readonly' : '' %>>
        <% if (ingrediente) { %>
          <div class="form-text">Para alterar a quantidade atual de um item existente, use o botão Ajustar na listagem.</div>
        <% } %>
      </div>

      <div class="col-md-3">
        <label class="form-label">Estoque Mínimo (Alerta)</label>
        <input type="number" step="0.01" class="form-control" name="estoque_minimo" value="<%= ingrediente?.estoque_minimo || 0 %>" required placeholder="Ex: 5000">
      </div>

      <div class="col-md-3">
        <label class="form-label">Custo Unitário (R$)</label>
        <input type="number" step="0.001" class="form-control" name="custo_unitario" value="<%= ingrediente?.custo_unitario || 0 %>" placeholder="Custo por unidade/g">
      </div>

      <div class="col-md-3">
        <label class="form-label">Preço Adicional (Pizza Custom.)</label>
        <input type="number" step="0.01" class="form-control" name="preco_adicional" value="<%= ingrediente?.preco_adicional || 0 %>" placeholder="Valor cobrado ao adicionar">
      </div>

      <div class="col-12 mt-4">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="ativo" id="ativoCheck" <%= (ingrediente ? ingrediente.ativo : 1) ? 'checked' : '' %>>
          <label class="form-check-label" for="ativoCheck">Ingrediente Ativo para Vendas e Montagem</label>
        </div>
      </div>

      <div class="col-12 d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary btn-lg px-5">
          <i class="fa-solid fa-save me-2"></i> <%= ingrediente ? 'Atualizar' : 'Salvar Ingrediente' %>
        </button>
        <a href="/estoque" class="btn btn-outline-secondary btn-lg px-5">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
