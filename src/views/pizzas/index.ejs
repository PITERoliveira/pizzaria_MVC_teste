<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">Cardápio & Receitas</h2>
    <p class="text-muted mb-0">Gerencie pizzas do cardápio, preços por tamanho e ingredientes da receita para controle de custo.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/pizzas/customizar" class="btn btn-warning rounded-pill px-4">
      <i class="fa-solid fa-wand-magic-sparkles me-2"></i> Montar Pizza Customizada
    </a>
    <a href="/pizzas/nova" class="btn btn-primary rounded-pill px-4 shadow-sm">
      <i class="fa-solid fa-plus me-2"></i> Nova Pizza
    </a>
  </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-body">
    <form action="/pizzas" method="GET" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label small text-muted">Categoria</label>
        <select class="form-select" name="categoria" onchange="this.form.submit()">
          <option value="todas" <%= categoriaSelecionada === 'todas' ? 'selected' : '' %>>Todas</option>
          <% categorias.forEach(cat => { %>
            <option value="<%= cat %>" <%= categoriaSelecionada === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-8">
        <label class="form-label small text-muted">Buscar</label>
        <div class="input-group">
          <input type="text" class="form-control" name="search" value="<%= search %>" placeholder="Buscar por nome ou descrição...">
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-search"></i></button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Grid de Pizzas -->
<div class="row g-4">
  <% if (pizzas && pizzas.length > 0) { %>
    <% pizzas.forEach(pizza => { %>
      <div class="col-xl-3 col-md-6">
        <div class="card h-100 overflow-hidden">
          <div class="position-relative" style="height: 200px; overflow: hidden;">
            <img src="<%= pizza.imagem || 'https://images.unsplash.com/photo-1513104890138-7c749659a591?w=500' %>" alt="<%= pizza.nome %>" class="w-100 h-100 object-fit-cover" style="transition: transform 0.3s ease;">
          </div>
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="fw-bold mb-0"><%= pizza.nome %></h5>
              <span class="badge <%= pizza.ativa ? 'bg-success' : 'bg-danger' %>"><%= pizza.ativa ? 'Ativa' : 'Inativa' %></span>
            </div>
            <p class="text-muted small flex-grow-1"><%= pizza.descricao ? pizza.descricao.substring(0, 90) + '...' : 'Sem descrição' %></p>
            <p class="text-muted small"><span class="badge bg-secondary"><%= pizza.categoria %></span></p>
            
            <div class="row g-1 text-center mt-2">
              <% if (pizza.preco_brotinho > 0) { %>
                <div class="col-6">
                  <small class="text-muted">Brotinho</small>
                  <div class="fw-bold text-success">R$ <%= pizza.preco_brotinho.toFixed(2) %></div>
                </div>
              <% } %>
              <% if (pizza.preco_media > 0) { %>
                <div class="col-6">
                  <small class="text-muted">Média</small>
                  <div class="fw-bold text-success">R$ <%= pizza.preco_media.toFixed(2) %></div>
                </div>
              <% } %>
              <% if (pizza.preco_grande > 0) { %>
                <div class="col-6">
                  <small class="text-muted">Grande</small>
                  <div class="fw-bold text-success">R$ <%= pizza.preco_grande.toFixed(2) %></div>
                </div>
              <% } %>
              <% if (pizza.preco_familia > 0) { %>
                <div class="col-6">
                  <small class="text-muted">Família</small>
                  <div class="fw-bold text-success">R$ <%= pizza.preco_familia.toFixed(2) %></div>
                </div>
              <% } %>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top">
            <div class="d-flex gap-2 w-100">
              <a href="/pizzas/<%= pizza.id %>/editar" class="btn btn-outline-primary btn-sm w-100" title="Editar">
                <i class="fa-solid fa-pen me-1"></i> Editar
              </a>
              <form action="/pizzas/<%= pizza.id %>/deletar" method="POST" class="w-100" onsubmit="return confirm('Tem certeza que deseja excluir esta pizza?');">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100" title="Excluir">
                  <i class="fa-solid fa-trash me-1"></i> Excluir
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="col-12">
      <div class="card text-center py-5">
        <i class="fa-solid fa-pizza-slice fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">Nenhuma pizza cadastrada</h4>
        <a href="/pizzas/nova" class="btn btn-primary mt-3">Cadastrar Primeira Pizza</a>
      </div>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>